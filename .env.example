# Copy to .env and fill in. Never commit .env. Never paste keys into chat or logs.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Server-side only (sync script, MCP server). Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: lets the API verify JWTs locally instead of relying on PostgREST alone.
SUPABASE_JWT_SECRET=

# memory | supabase
MPIRE_REPO_BACKEND=memory
# Where run outputs live locally (the sync script reads from here)
MPIRE_OUTPUT_DIR=output/audits
# Where the API listens
MPIRE_API_HOST=127.0.0.1
MPIRE_API_PORT=8080
