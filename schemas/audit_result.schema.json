{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mpire.local/schemas/audit_result.schema.json",
  "title": "Audit result",
  "description": "Output of preapproval-audit and submission-readiness. Every PASS cites evidence. FAIL and MISSING carry a proposed action. REVIEW carries a reason and reviewer role.",
  "type": "object",
  "required": ["schema_version", "loan_id", "run_id", "audit_type", "generated_at", "generated_by", "inputs", "catalog", "overall_status", "findings", "summary", "missing_documents", "conflicts", "approvals_required", "known_limitations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "loan_id": { "$ref": "common.defs.schema.json#/$defs/loan_id" },
    "run_id": { "$ref": "common.defs.schema.json#/$defs/run_id" },
    "audit_type": { "type": "string", "enum": ["PREAPPROVAL", "SUBMISSION_READINESS"] },
    "generated_at": { "$ref": "common.defs.schema.json#/$defs/iso_datetime" },
    "generated_by": {
      "type": "object",
      "required": ["skill"],
      "properties": {
        "skill": { "type": "string", "minLength": 1 },
        "tool_versions": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "description": "Every input file consumed, with its hash, so the run is reproducible.",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "common.defs.schema.json#/$defs/sha256" },
          "role": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "catalog": {
      "type": "object",
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "common.defs.schema.json#/$defs/sha256" },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "overall_status": {
      "description": "Null for PREAPPROVAL. For SUBMISSION_READINESS: READY only when every applicable blocking rule is PASS with evidence.",
      "oneOf": [ { "$ref": "common.defs.schema.json#/$defs/overall_status" }, { "type": "null" } ]
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "summary": {
      "type": "object",
      "required": ["counts", "blocking_open", "coverage"],
      "properties": {
        "counts": {
          "type": "object",
          "required": ["PASS", "FAIL", "MISSING", "REVIEW", "NOT_APPLICABLE"],
          "properties": {
            "PASS": { "type": "integer", "minimum": 0 },
            "FAIL": { "type": "integer", "minimum": 0 },
            "MISSING": { "type": "integer", "minimum": 0 },
            "REVIEW": { "type": "integer", "minimum": 0 },
            "NOT_APPLICABLE": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "blocking_open": { "type": "integer", "minimum": 0, "description": "Blocking findings whose result is not PASS or NOT_APPLICABLE." },
        "coverage": {
          "type": "object",
          "required": ["catalog_items_in_phase", "items_evaluated", "coverage_percent"],
          "properties": {
            "catalog_items_in_phase": { "type": "integer", "minimum": 0 },
            "items_evaluated": { "type": "integer", "minimum": 0 },
            "coverage_percent": { "$ref": "common.defs.schema.json#/$defs/decimal_string" },
            "unevaluated_rule_ids": { "type": "array", "items": { "$ref": "common.defs.schema.json#/$defs/rule_id" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "missing_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_type", "description", "rule_ids"],
        "properties": {
          "document_type": { "$ref": "common.defs.schema.json#/$defs/document_type" },
          "borrower_id": { "oneOf": [ { "$ref": "common.defs.schema.json#/$defs/borrower_id" }, { "type": "null" } ] },
          "description": { "type": "string", "minLength": 1 },
          "rule_ids": { "type": "array", "items": { "$ref": "common.defs.schema.json#/$defs/rule_id" }, "minItems": 1 }
        },
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "description": "Facts that disagree across the 1003, credit, documents, contract, AUS, and LOS.",
      "items": {
        "type": "object",
        "required": ["conflict_id", "field", "values", "explanation", "rule_ids"],
        "properties": {
          "conflict_id": { "type": "string", "pattern": "^CF-[0-9]{3}$" },
          "field": { "type": "string", "minLength": 1 },
          "values": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["source", "value", "evidence_ids"],
              "properties": {
                "source": { "type": "string", "minLength": 1 },
                "value": { "type": ["string", "number", "boolean", "null"] },
                "evidence_ids": { "type": "array", "items": { "$ref": "common.defs.schema.json#/$defs/evidence_id" } }
              },
              "additionalProperties": false
            }
          },
          "explanation": { "type": "string", "minLength": 1 },
          "rule_ids": { "type": "array", "items": { "$ref": "common.defs.schema.json#/$defs/rule_id" } }
        },
        "additionalProperties": false
      }
    },
    "proposed_los_corrections": { "type": "array", "items": { "$ref": "#/$defs/proposed_action" } },
    "proposed_client_needs": { "type": "array", "items": { "$ref": "#/$defs/proposed_action" } },
    "proposed_los_notes": { "type": "array", "items": { "$ref": "#/$defs/proposed_action" } },
    "approvals_required": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "approver_role", "rule_ids"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "approver_role": { "$ref": "common.defs.schema.json#/$defs/reviewer_role" },
          "rule_ids": { "type": "array", "items": { "$ref": "common.defs.schema.json#/$defs/rule_id" } }
        },
        "additionalProperties": false
      }
    },
    "known_limitations": {
      "type": "array",
      "minItems": 1,
      "description": "Always visible. At minimum: what this release does not evaluate.",
      "items": { "type": "string", "minLength": 1 }
    },
    "los_export_present": { "type": "boolean", "description": "False means no claim about LOS completeness may be made." }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["finding_id", "rule_id", "result", "evidence_ids", "explanation", "discrepancy", "proposed_action", "blocking", "reviewer_role", "confidence", "review_reason"],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^F-[0-9]{3,4}$" },
        "rule_id": { "$ref": "common.defs.schema.json#/$defs/rule_id" },
        "result": { "$ref": "common.defs.schema.json#/$defs/result_value" },
        "evidence_ids": { "type": "array", "items": { "$ref": "common.defs.schema.json#/$defs/evidence_id" }, "uniqueItems": true },
        "explanation": { "type": "string", "minLength": 1 },
        "discrepancy": { "$ref": "common.defs.schema.json#/$defs/nullable_string" },
        "proposed_action": { "$ref": "common.defs.schema.json#/$defs/nullable_string" },
        "blocking": { "type": "boolean" },
        "reviewer_role": { "oneOf": [ { "$ref": "common.defs.schema.json#/$defs/reviewer_role" }, { "type": "null" } ] },
        "confidence": { "$ref": "common.defs.schema.json#/$defs/confidence" },
        "review_reason": { "$ref": "common.defs.schema.json#/$defs/nullable_string" },
        "calculation": { "oneOf": [ { "$ref": "common.defs.schema.json#/$defs/calculation_trail" }, { "type": "null" } ] },
        "guideline_source": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["source_id", "effective_date", "citation"],
              "properties": {
                "source_id": { "type": "string", "minLength": 1, "description": "Id from config/approved_sources.yaml" },
                "effective_date": { "$ref": "common.defs.schema.json#/$defs/iso_date" },
                "citation": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "PASS" } } },
          "then": { "properties": { "evidence_ids": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "result": { "enum": ["FAIL", "MISSING"] } } },
          "then": { "properties": { "proposed_action": { "type": "string", "minLength": 1 } } }
        },
        {
          "if": { "properties": { "result": { "const": "REVIEW" } } },
          "then": {
            "properties": {
              "review_reason": { "type": "string", "minLength": 1 },
              "reviewer_role": { "$ref": "common.defs.schema.json#/$defs/reviewer_role" }
            }
          }
        },
        {
          "if": { "properties": { "result": { "const": "NOT_APPLICABLE" } } },
          "then": { "properties": { "evidence_ids": { "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "proposed_action": {
      "type": "object",
      "description": "A DRAFT action for a human to accept or reject. Never executed by this repository.",
      "required": ["action_id", "action_type", "target", "description", "rule_ids", "evidence_ids", "approver_role", "status"],
      "properties": {
        "action_id": { "type": "string", "pattern": "^PA-[0-9]{3}$" },
        "action_type": { "type": "string", "enum": ["LOS_FIELD_CORRECTION", "LOS_NOTE", "CLIENT_NEED", "AGENT_FOLLOW_UP", "TITLE_FOLLOW_UP", "OTHER"] },
        "target": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "before_value": { "type": ["string", "number", "boolean", "null"] },
        "after_value": { "type": ["string", "number", "boolean", "null"] },
        "rule_ids": { "type": "array", "items": { "$ref": "common.defs.schema.json#/$defs/rule_id" } },
        "evidence_ids": { "type": "array", "items": { "$ref": "common.defs.schema.json#/$defs/evidence_id" } },
        "approver_role": { "$ref": "common.defs.schema.json#/$defs/reviewer_role" },
        "status": { "type": "string", "const": "DRAFT_HUMAN_APPROVAL_REQUIRED" }
      },
      "additionalProperties": false
    }
  }
}
