{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mpire.local/schemas/checklist_catalog.schema.json",
  "title": "Checklist catalog",
  "description": "config/checklist_catalog.yaml: every operative statement from the source checklists, with a stable id and page traceability. Source wording is preserved verbatim; consolidation decisions are recorded separately, never applied silently.",
  "type": "object",
  "required": ["catalog_version", "sources", "items", "conflicts", "consolidation_decisions"],
  "additionalProperties": false,
  "properties": {
    "catalog_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "normalized_at": { "type": ["string", "null"] },
    "reviewed_by": { "type": ["string", "null"], "description": "Licensed reviewer who signed off on the normalization. Null until sign-off." },
    "reviewed_at": { "type": ["string", "null"] },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "title", "filename", "sha256", "page_count"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "filename": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "common.defs.schema.json#/$defs/sha256" },
          "page_count": { "type": "integer", "minimum": 1 },
          "version_or_date": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict_id", "rule_ids", "description", "resolution", "resolved_by"],
        "properties": {
          "conflict_id": { "type": "string", "pattern": "^CAT-CF-[0-9]{3}$" },
          "rule_ids": { "type": "array", "minItems": 2, "items": { "$ref": "common.defs.schema.json#/$defs/rule_id" } },
          "description": { "type": "string", "minLength": 1 },
          "resolution": { "type": ["string", "null"], "description": "Null until a reviewer resolves it. Both items stay in force meanwhile." },
          "resolved_by": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "consolidation_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "rule_ids", "rationale", "approved_by"],
        "properties": {
          "decision_id": { "type": "string", "pattern": "^CAT-CD-[0-9]{3}$" },
          "rule_ids": { "type": "array", "minItems": 2, "items": { "$ref": "common.defs.schema.json#/$defs/rule_id" } },
          "rationale": { "type": "string", "minLength": 1 },
          "approved_by": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["id", "source_document", "source_page", "source_text", "phase", "category", "applies_when", "required_evidence", "fields_to_compare", "evaluation_method", "result_values", "blocking_if_failed", "proposed_action", "required_human_role"],
      "properties": {
        "id": { "$ref": "common.defs.schema.json#/$defs/rule_id" },
        "source_document": { "type": "string", "pattern": "^SRC-[A-Z0-9]+$" },
        "source_page": { "type": "integer", "minimum": 1 },
        "source_text": { "type": "string", "minLength": 1, "description": "Verbatim wording from the source. Never paraphrased." },
        "phase": { "type": "string", "enum": ["PREAPPROVAL", "SUBMISSION"] },
        "category": {
          "type": "string",
          "enum": ["CREDIT", "LIABILITIES", "REO", "EMPLOYMENT", "INCOME_REGULAR", "INCOME_VARIABLE", "INCOME_SELF_EMPLOYED", "INCOME_OTHER", "ASSETS", "GIFT_FUNDS", "RETIREMENT_FUNDS", "TITLE", "PROPERTY", "CONTRACT", "IDENTITY", "APPLICATION_1003", "DISCLOSURES", "LOS", "AUS", "OTHER"]
        },
        "applies_when": { "type": "string", "minLength": 1, "description": "Plain-language applicability condition, e.g. 'always', 'purchase transactions', 'borrower has rental income'." },
        "required_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "fields_to_compare": { "type": "array", "items": { "type": "string" } },
        "evaluation_method": { "$ref": "common.defs.schema.json#/$defs/evaluation_method" },
        "result_values": { "type": "array", "minItems": 1, "items": { "$ref": "common.defs.schema.json#/$defs/result_value" } },
        "blocking_if_failed": { "type": "boolean" },
        "proposed_action": { "type": "string", "minLength": 1 },
        "required_human_role": { "oneOf": [ { "$ref": "common.defs.schema.json#/$defs/reviewer_role" }, { "type": "null" } ] },
        "ambiguous": { "type": "boolean", "default": false, "description": "True when the source language is ambiguous; such items always route to REVIEW." },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
